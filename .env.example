# .env.example — copy to .env and fill in real keys
# .env is gitignored; .env.example is committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env, fill in keys
#
# Vein reads this via python-dotenv (auto-loaded at startup).
# All keys are optional — only needed for the provider you enable in config/ai_providers.yaml

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google (Gemini) ─────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Local override (optional) ───────────────────────────────
# Override the base_url in ai_providers.yaml if needed
# OLLAMA_BASE_URL=http://localhost:11434
# RAPID_MLX_BASE_URL=http://localhost:8080

# ── Vein internal ───────────────────────────────────────────
# VEIN_PROJECT_ROOT=/Users/lion/Documents/vein    # auto-detected from .vein/ walk-up
# VEIN_LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING

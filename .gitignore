# Vein — .gitignore

# ── secrets ──────────────────────────────────────────────────
.env

# ── generated / cache ────────────────────────────────────────
.vein/index/
.vein/cache/
.vein/BRIEF.md

# ── batch run logs ───────────────────────────────────────────
cmd/logs/
cmd/batch/logs/
*.log

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
dist/
build/
*.egg-info/
.ruff_cache/
.pytest_cache/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.vein/

# 一次性本機工具/雜項（勿追蹤）
pytest-cache-files-*/
remove_git_lock.sh
